      "expected_stderr": "",
      "timeout_seconds": 5
    },
    {
      "id": "write-answer-file",
      "tags": ["demo", "filesystem"],
      "prompt": "write-answer-file",
      "expected_exit_code": 0,
      "expected_stdout": "",
      "expected_stderr": "",
      "expected_files": {
