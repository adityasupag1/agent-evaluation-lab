      "expected_files": {
        "output.txt": "AGENT EVALUATION"
      },
      "timeout_seconds": 5
    },
    {
      "id": "nested-artifact",
      "tags": ["demo", "filesystem"],
      "prompt": "nested-artifact",
      "expected_exit_code": 0,
      "expected_stdout": "",
      "expected_stderr": "",
      "expected_files": {
